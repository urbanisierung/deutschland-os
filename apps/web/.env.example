# Required: OpenAI API key used by the server-side generation endpoint.
OPENAI_API_KEY=sk-...

# Optional: override the model (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# --- Scraper reliability / anti-blocking (all optional) ---

# Route listing fetches through a proxy or managed scraping API. The template
# must contain {url}; {key} is replaced with SCRAPER_API_KEY. This is the
# decisive lever for getting past advanced bot protection (e.g. DataDome on
# ImmoScout24), since the provider supplies residential IPs, JS rendering, and
# CAPTCHA solving. Examples:
#   ScraperAPI: https://api.scraperapi.com/?api_key={key}&url={url}&render=true
#   ScrapingBee: https://app.scrapingbee.com/api/v1/?api_key={key}&url={url}&render_js=true
#   ZenRows:     https://api.zenrows.com/v1/?apikey={key}&url={url}&js_render=true
# SCRAPER_GATEWAY_TEMPLATE=
# SCRAPER_API_KEY=

# Per-request timeout in milliseconds (default 15000).
# SCRAPER_TIMEOUT_MS=15000

# Retry attempts after the first try (default 3).
# SCRAPER_RETRIES=3

# Cache successful listing fetches for this many ms (0 = disabled).
# SCRAPER_CACHE_TTL_MS=600000
