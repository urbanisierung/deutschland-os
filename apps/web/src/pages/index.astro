---
import { ApplicationForm } from "../components/ApplicationForm";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Deutschland OS · Wohnungsbewerbung</title>
  </head>
  <body>
    <main>
      <header>
        <h1>Wohnungsbewerbung-Generator</h1>
        <p>
          Erzeugt aus Ihrem Profil und einem Inserat ein maßgeschneidertes, formelles
          Bewerbungsanschreiben — inklusive Red-Flag-Prüfung.
        </p>
      </header>
      <ApplicationForm client:load />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #0f1115;
    --card: #1a1d24;
    --fg: #e7e9ee;
    --muted: #9aa3b2;
    --accent: #ffce00;
    --border: #2a2f3a;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: var(--bg);
    color: var(--fg);
    line-height: 1.5;
  }
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }
  header h1 {
    margin: 0 0 0.25rem;
  }
  header p {
    color: var(--muted);
    margin-top: 0;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  fieldset {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.25rem 1.25rem;
    background: var(--card);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  legend {
    padding: 0 0.5rem;
    font-weight: 600;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
  }
  .field span {
    color: var(--muted);
  }
  input,
  textarea {
    background: #0f1115;
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.5rem 0.6rem;
    font: inherit;
  }
  .checkbox {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .toggle {
    display: flex;
    gap: 0.5rem;
  }
  .toggle button {
    flex: 1;
    background: #0f1115;
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.5rem;
    cursor: pointer;
  }
  .toggle button.active {
    border-color: var(--accent);
    color: var(--accent);
  }
  button.primary {
    background: var(--accent);
    color: #111;
    border: none;
    border-radius: 10px;
    padding: 0.75rem;
    font-weight: 700;
    cursor: pointer;
  }
  button.primary:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .error {
    color: #ff6b6b;
  }
  .result {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    background: var(--card);
  }
  .meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .badge {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-size: 0.85rem;
  }
  .badge.go {
    border-color: #3ddc84;
    color: #3ddc84;
  }
  .badge.stop {
    border-color: #ff6b6b;
    color: #ff6b6b;
  }
  .flags {
    color: var(--accent);
  }
  .listing-title {
    font-weight: 600;
  }
  pre {
    white-space: pre-wrap;
    word-break: break-word;
    background: #0f1115;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    font: inherit;
  }
</style>
